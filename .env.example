# ==============================================================================
# ResearchMind - Environment Configuration Template
# Copy this file to '.env' and fill in your actual API keys.
# NEVER commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# Groq API Key (Required)
# Obtain a free or paid API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model Name (Optional, defaults to openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Tavily Search API Key (Required)
# Obtain a free or paid API key at: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

